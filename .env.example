# Public Sanity content. Never put a write token in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SITE_URL=https://iva.manojmukherjee.co.in

# Server-only AI configuration
GOOGLE_GENERATIVE_AI_API_KEY=
IVA_CHAT_MODEL=gemini-flash-latest
IVA_CHAT_DAILY_LIMIT=16
IVA_CHAT_BURST_LIMIT=4
IVA_CHAT_CACHE_SECRET=

# Vercel's Upstash integration provisions these names automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Standalone Upstash credentials are also supported:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local migration scripts only; the deployed site needs no Sanity write token.
# Use `pnpm exec sanity login` for Studio validation, exports, and CORS management.
SANITY_WRITE_TOKEN=

# Server-only shared secret for the signed Sanity publish webhook.
SANITY_REVALIDATE_SECRET=
